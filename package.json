{
  "name": "learning-expo",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "// --- RUN APP --- //": "",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "// --- CLEAN & FIX CACHE ERROR --- //": "",
    "clean": "expo start -c",
    "clean:full": "rimraf node_modules .expo ios android yarn.lock && yarn install",
    "clean:android": "cd android && .\\gradlew clean && cd ..",
    "// --- BUILD EAS --- //": "",
    "build:apk:preview": "eas build -p android --profile preview",
    "build:apk:development": "eas build -p android --profile development",
    "build:apk:production": "eas build -p android --profile production",
    "build:aab:production:local": "eas build --platform android --local --profile production",
    "// --- BUILD LOCAL --- //": "",
    "prebuild": "npx expo prebuild --platform android",
    "build:apk:local": "npm run prebuild && cd android && gradlew.bat assembleRelease",
    "build:apk:local:clean": "rimraf android && npm run build:apk:local",
    "build:aab:local": "npm run prebuild && cd android && .\\gradlew bundleRelease",
    "// --- TOOLS --- //": "",
    "android:gen-keystore": "cd android && ./gradlew app:signingReport",
    "android:gen-upload-keystore": "keytool -genkey -v -keystore my-upload-key.jks -alias my-key-alias -keyalg RSA -keysize 2048 -validity 10000",
    "android:read-upload-keystore": "keytool -list -v -keystore my-upload-key.jks -alias my-key-alias",
    "lint": "expo lint",
    "prepare": "husky",
    "check-type": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
