{
  "expo": {
    "name": "souvenir",
    "slug": "souvenir",
    "version": "1.0.1",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./src/assets/icons/logo-sky-store-icon-app-mobile.png",
    "scheme": "souvenir",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.souvenir",
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#537b90",
        "foregroundImage": "./src/assets/icons/logo-sky-store.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.souvenir",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.INTERNET",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "versionCode": 15
    },
    "plugins": [
      "./scripts/withAndroidSigning",
      "./scripts/withShortBuildDir",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/icons/logo-sky-store.png",
          "imageWidth": 266,
          "resizeMode": "contain",
          "backgroundColor": "#537b90",
          "dark": {
            "backgroundColor": "#537b90"
          }
        }
      ],
      ["expo-secure-store"],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      ["@lovesworking/watermelondb-expo-plugin-sdk-52-plus"],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "simdjson",
                "path": "../node_modules/@nozbe/simdjson",
                "modular_headers": true
              }
            ]
          },
          "android": {
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so"]
            }
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8df576a7-be37-45dd-9d84-24eeeff07e0f"
      }
    }
  }
}
